# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: production web origin for API CORS checks (defaults to allowing same-host, localhost, and Chrome extensions)
# NEXT_PUBLIC_SITE_URL=https://your-wordtap-domain.vercel.app

# Optional: private OCR.space fallback key used server-side by /api/ocr
# OCR_SPACE_API_KEY=

# Stage 2 Custom YouTube Contextual Learning Player (server-side only — never expose in client!)
# Option A (Recommended): Official YouGlish REST API v1 key (commercial plans: https://youglish.com/api/plans)
# YOUGLISH_API_KEY=
# Option B: Official RapidAPI Filmot Subtitle Search key
# RAPIDAPI_FILMOT_KEY=
# Option C: Official YouTube Data API v3 + licensed Transcript provider
# YOUTUBE_API_KEY=
# SUPADATA_API_KEY=
# TRANSCRIPT_API_KEY=
# Optional: Supabase Service Role key for server-side shared video library caching
# SUPABASE_SERVICE_ROLE_KEY=
