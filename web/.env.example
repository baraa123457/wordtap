# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: production web origin for API CORS checks (defaults to allowing same-host, localhost, and Chrome extensions)
# NEXT_PUBLIC_SITE_URL=https://your-wordtap-domain.vercel.app

# Optional: private OCR.space fallback key used server-side by /api/ocr
# OCR_SPACE_API_KEY=

# Stage 2 Official YouGlish Widget configuration
# Set to "false" to disable the embedded YouGlish widget until commercial permission is obtained from youglish.com
NEXT_PUBLIC_YOUGLISH_WIDGET_ENABLED=true
# Optional: YouGlish commercial partner key (removes free-tier sponsored banners once licensed from youglish.com/api/plans)
# NEXT_PUBLIC_YOUGLISH_PARTNER_KEY=
# Optional: set to "true" to require explicit opt-in cookie consent before loading the YouGlish/YouTube embed
# NEXT_PUBLIC_YOUGLISH_REQUIRE_COOKIE_CONSENT=false
