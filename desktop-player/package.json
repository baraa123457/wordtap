{
  "name": "wordtap-player",
  "version": "1.0.11",
  "description": "WordTap Desktop Video Player with Interactive Subtitles and Word Sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-packager . \"WordTap-VLC-Player\" --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite",
    "build-dist": "electron-builder --win --publish never",
    "build-exe": "electron-builder --win nsis --publish never",
    "build-msi": "electron-builder --win msi --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac-arm64": "electron-builder --mac --arm64 --publish never",
    "build:mac-x64": "electron-builder --mac --x64 --publish never"
  },
  "build": {
    "appId": "com.wordtap.player",
    "productName": "WordTap",
    "protocols": [
      {
        "name": "WordTap Protocol",
        "schemes": [
          "wordtap"
        ]
      }
    ],
    "fileAssociations": [
      { "ext": ["mp4", "mkv", "webm", "mov", "avi", "m4v", "ts", "flv", "mpg", "mpeg"], "name": "Video File", "role": "Viewer" },
      { "ext": ["srt", "vtt"], "name": "Subtitle File", "role": "Viewer" }
    ],
    "directories": {
      "output": "dist-release"
    },
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "icon.ico",
      "icon.png",
      "!dist/**",
      "!dist-installers/**",
      "!dist-latest/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "icon.png",
      "artifactName": "WordTap-mac-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "WordTap Player"
    },
    "win": {
      "artifactName": "WordTap-Setup-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WordTap Player"
    },
    "msi": {
      "oneClick": false,
      "shortcutName": "WordTap Player"
    }
  },
  "keywords": [
    "wordtap",
    "video-player",
    "subtitles",
    "vlc",
    "language-learning"
  ],
  "author": "WordTap",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "opensubtitles-api": "^5.1.2",
    "xmlrpc": "^1.3.2"
  }
}
