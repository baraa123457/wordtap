{
  "manifest_version": 3,
  "name": "WordTap: Subtitle Click Translator",
  "version": "2.2.0",
  "description": "Click any word in video subtitles, select text on any site, or capture screen OCR to translate and save to WordTap.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "icons": {
    "16":  "icon16.png",
    "32":  "icon32.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://*.supabase.co/*",
    "https://api.ocr.space/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://www.amazon.com/gp/video/*",
        "*://www.disneyplus.com/*",
        "*://www.udemy.com/*",
        "*://www.coursera.org/*",
        "*://www.ted.com/*",
        "*://*.bbc.com/*",
        "*://*.bbc.co.uk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["select-translate.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "take-ocr-screenshot": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "WordTap: Capture Screen Area OCR & Translate"
    }
  },
  "action": {
    "default_title": "WordTap",
    "default_icon": {
      "16":  "icon16.png",
      "32":  "icon32.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
